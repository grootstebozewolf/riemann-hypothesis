theorem combLine_single [DecidableEq κ] (A : κ → HermLine ι)
    (cA : ∀ j z, (¬ ∀ k, ∃ i, z ⟨k, i⟩ ≠ 0) → (A j).h z = 0) (o : κ) : combLine A (Pi.single o 1) = A o := by
