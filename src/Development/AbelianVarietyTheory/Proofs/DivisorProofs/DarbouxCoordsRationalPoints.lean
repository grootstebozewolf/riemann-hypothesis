  ring

def dblEquiv (d₁ : Darboux (symp c ξ JA JB) κ) : Matrix α (β ⊕ β) E ≃ₗ[R] (κ ⊕ κ → R) × (κ ⊕ κ → R) where
  toFun z := (Sum.elim (d₁.e z.toCols₁).1 (d₁.e z.toCols₂).1, Sum.elim (d₁.e z.toCols₁).2 (-(d₁.e z.toCols₂).2))
