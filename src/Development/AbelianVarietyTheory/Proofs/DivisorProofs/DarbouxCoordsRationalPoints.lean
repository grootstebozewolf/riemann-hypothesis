theorem dblEquivFun_symm_coe {κ : Type} (T : ((κ → R) → ℂ) ≃ₗ[ℂ] ((κ → R) → ℂ)) :
    (dblEquivFun T).symm.toLinearMap = partR (conjMap T.symm.toLinearMap) ∘ₗ partL (κ' := κ) T.symm.toLinearMap := rfl

