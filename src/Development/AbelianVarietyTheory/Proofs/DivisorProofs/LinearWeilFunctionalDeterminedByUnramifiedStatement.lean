    funext y
    by_cases hy : y ∈ box v y₀
    · have hm : (Homeomorph.subRight y₀) y ∈ {x : κ → Fv F v | ∀ k, x k ∈ v.adicCompletionIntegers F} :=
        fun k => by simpa using hy k
      rw [Set.indicator_of_mem hy, Function.comp_apply, Set.indicator_of_mem hm]; rfl
