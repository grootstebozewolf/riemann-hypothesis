      have h1 : ψ0 w * (starRingEnd ℂ) (ψ0 w) = 1 := by
        rw [Complex.mul_conj, Complex.normSq_eq_norm_sq, GlobalTheory.norm_addChar_nonarch ψ0 hψ w]
