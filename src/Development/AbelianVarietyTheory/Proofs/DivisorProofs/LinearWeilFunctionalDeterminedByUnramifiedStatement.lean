    have e2 : (ψ0 (l (y - y')) - 1) * ip μ (Tr (-y) x0) (Tr (-y') x0) = 0 := by linear_combination e
    rcases mul_eq_zero.mp e2 with h3 | h3
    · exact absurd (sub_eq_zero.mp h3) hl2
    · exact h3

