    (fun k _ w c c' hw h h' => by
      obtain ⟨d, hd⟩ := key k w hw
      exact (eq_inv_of_mul_eq_one_left (hd c h)).trans (eq_inv_of_mul_eq_one_left (hd c' h')).symm)
