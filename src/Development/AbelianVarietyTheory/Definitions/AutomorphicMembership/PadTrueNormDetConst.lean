  change y = X.fromSpecStalk x (spMap f (closedPoint K))
  obtain ⟨q, rfl⟩ := (X.range_fromSpecStalk (x := x)).ge (hy.trans ((X.range_fromSpecStalk (x := x)).le ⟨_, rfl⟩))
