    simp only [LinearMap.pi_apply, LinearMap.sub_apply, LinearMap.id_apply] at h1
    change actQ L _ hI g (Submodule.Quotient.mk x) - Submodule.Quotient.mk x = Submodule.Quotient.mk (evT L g c) at h1
