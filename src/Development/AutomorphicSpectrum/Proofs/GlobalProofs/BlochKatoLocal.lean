    have e₂ : actVdR PD ρ g d = d := sub_eq_zero.1 ((Submodule.mem_iInf _).1 h₂ g)
    have f₁ : pr P B (x - φVB PD (LL := LL) (V := V) x) (b g ⊗ₜ[Qp] 1) =
        actVB PD (charRep (cycLL PD LL)) g (w - φVB PD (LL := LL) (V := LL) w) -
