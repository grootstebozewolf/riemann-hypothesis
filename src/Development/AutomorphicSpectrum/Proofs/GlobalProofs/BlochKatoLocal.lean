    (hP : ∀ g x y, P (ρ g x) (ρ' g y) = ((cycLL PD LL g : LLˣ) : LL) * P x y)
    (hsurj : ∀ (u : LL ⊗[Qp] B) (w : LL ⊗[Qp] BdR), ∃ (x : LL ⊗[Qp] B) (y : LL ⊗[Qp] BdR),
