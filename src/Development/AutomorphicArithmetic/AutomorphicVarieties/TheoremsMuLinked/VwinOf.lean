    fun K _ _ => (congrArg (algebraMap K Ω) (map_natCast (algebraMap (𝓞 K) K) l)).trans (map_natCast _ l)
  have h2 : (s.A v.1).valuation (algebraMap L Ω (((l : ℕ) : 𝓞 L) : L)) < 1 := by
