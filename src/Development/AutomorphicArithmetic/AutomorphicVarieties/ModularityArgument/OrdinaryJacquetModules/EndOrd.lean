private theorem one_part (PH : Af.HypothesesH) (hUni : CompUnique) {E Ω : Type} [Field E] [NumberField E] [IsCMField E] [Field Ω]
    [Algebra E Ω] [IsAlgClosure E Ω] {l : ℕ} [Fact l.Prime] (ι : Qbar l ≃+* ℂ) {n : ℕ} (hn1 : 1 ≤ n)
